# Only evaluation runtime and documentation files are versioned. All datasets stay local.
*
!/.gitignore
!/README.md
!/assets/
/assets/*
!/assets/city-jev-teaser.png
!/pyproject.toml
!/uv.lock
!/configs/
/configs/*
!/configs/models.json
!/src/
/src/*
!/src/__init__.py
!/src/dataset/
/src/dataset/*
!/src/dataset/__init__.py
!/src/dataset/schema.py
!/src/dataset/reader.py
!/src/eval/
/src/eval/*
!/src/eval/__init__.py
!/src/eval/__main__.py
!/src/eval/final.py
!/src/eval/final_metrics.py
!/src/eval/metrics.py
!/src/model/
/src/model/*
!/src/model/*.py
!/tests/
/tests/*
!/tests/runtime/
/tests/runtime/*
!/tests/runtime/*.py
__pycache__/
*.pyc
.env
